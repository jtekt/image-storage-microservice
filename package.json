    "name": "image_storage_microservice",
    "description": "A microservice to store images and their metadata",
    "main": "index.ts",
    "scripts": {
        "dev": "nodemon index.ts --ignore ./uploads --ignore ./temp",
        "build": "tsc --outdir ./build -p . ",
